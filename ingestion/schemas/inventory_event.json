{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail-platform/schemas/inventory-event/v2.0.0",
  "title": "Inventory Event",
  "type": "object",
  "required": [
    "event_id",
    "event_time",
    "store_id",
    "product_id",
    "qty_delta",
    "event_type",
    "scanner_id",
    "schema_version"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_time": { "type": "string", "format": "date-time" },
    "store_id": { "type": "string", "pattern": "^STORE-\\d{3}$" },
    "product_id": { "type": "string", "pattern": "^PROD-\\d{4}$" },
    "qty_delta": { "type": "integer" },
    "event_type": {
      "type": "string",
      "enum": ["sale_deduction", "receipt", "adjustment", "transfer"]
    },
    "scanner_id": { "type": "string", "pattern": "^SCANNER-\\d{2}$" },
    "is_late": { "type": "boolean" },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of this event contract. Bump major for breaking changes, minor for optional additions."
    }
  }
}
