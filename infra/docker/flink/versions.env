# Single source of truth for Flink connector JAR versions.
#
# infra/docker/flink/Dockerfile pins these versions. tests/unit/test_flink_connector_versions.py
# fails if the Dockerfile drifts from this file.
#
# Update a version here, then update both the Dockerfile ARGs and the
# shell variables in install_flink_connectors.sh to match. CI will catch
# any miss.
FLINK_VERSION=1.17.1
ICEBERG_VERSION=1.4.3
KAFKA_CONNECTOR_VERSION=1.17.1
HADOOP_AWS_VERSION=3.3.6
AWS_SDK_VERSION=1.12.262
