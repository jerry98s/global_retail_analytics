# Single source of truth for Flink connector JAR versions.
#
# Both infra/docker/flink/Dockerfile (local Docker stack) and
# infra/emr-bootstrap/install_flink_connectors.sh (EMR/prod) pin these
# versions independently — neither Docker build args nor an EMR bootstrap
# action can natively `source` an env file at runtime. Instead,
# tests/unit/test_flink_connector_versions.py parses all three files and
# fails CI if the pins drift.
#
# Update a version here, then update both the Dockerfile ARGs and the
# shell variables in install_flink_connectors.sh to match. CI will catch
# any miss.
FLINK_VERSION=1.17.1
ICEBERG_VERSION=1.4.3
KAFKA_CONNECTOR_VERSION=1.17.1
HADOOP_AWS_VERSION=3.3.6
AWS_SDK_VERSION=1.12.262
