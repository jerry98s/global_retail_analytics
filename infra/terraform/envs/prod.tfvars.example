# Copy to prod.tfvars (git-ignored) and fill in the real IDs/secrets.
# Apply with: .\scripts\cloud\run_terraform.ps1 -Stack platform -Env prod -Action apply
#
# Same stack code as dev — only sizing, CIDRs, and secrets differ.

environment  = "prod"
aws_region   = "ap-southeast-1"
project_name = "retail-platform"
team_name    = "data-platform"

# Networking — these must come from a pre-existing shared network stack.
# This repo intentionally does NOT manage that VPC; bring your own.
vpc_id                 = "vpc-REPLACE_ME"
private_subnet_ids     = ["subnet-REPLACE_ME_AZ_A", "subnet-REPLACE_ME_AZ_B"]
msk_security_group_ids = ["sg-REPLACE_ME_MSK"]

# EMR pre-created service / EC2 roles.
emr_service_role_arn         = "arn:aws:iam::ACCOUNT_ID:role/EMR_DefaultRole"
emr_ec2_instance_profile_arn = "arn:aws:iam::ACCOUNT_ID:instance-profile/EMR_EC2_DefaultRole"

# Redshift Serverless (Gold warehouse). Needs >= 3 subnets across AZs.
redshift_subnet_ids    = ["subnet-REPLACE_ME_AZ_A", "subnet-REPLACE_ME_AZ_B", "subnet-REPLACE_ME_AZ_C"]
redshift_allowed_cidrs = ["10.0.0.0/8"] # tighten to your BI/VPC ranges
redshift_admin_username = "rs_admin"
redshift_admin_password = "REPLACE_ME_STRONG_SECRET" # prefer TF_VAR_redshift_admin_password
redshift_database_name  = "prod"
# base_capacity in RPUs; usage cap in RPU-hours/month (cost guardrail).
redshift_base_capacity_rpu      = 32
redshift_monthly_rpu_hour_limit = 1000

# Streamlit dashboard (App Runner). Two-step rollout:
#   1) enable_dashboard=true, dashboard_create_service=false -> apply (creates ECR)
#   2) build+push image to dashboard_ecr_repository_url, set create_service=true -> apply
enable_dashboard         = false
dashboard_create_service = false
dashboard_image_tag      = "latest"
# Needed only when redshift_publicly_accessible = false (VPC-only). The subnets'
# CIDRs must be inside redshift_allowed_cidrs so the connector can reach 5439.
dashboard_vpc_connector_subnet_ids = []

# Dashboard login (Cognito + ALB in front of a private App Runner). Without
# this the dashboard URL is public to anyone who finds it. Needs a domain you
# control and an ACM cert for it in this region. See dashboard/README.md.
# dashboard_enable_auth         = true
# dashboard_auth_domain_name    = "dashboard.example.com"
# dashboard_acm_certificate_arn = "arn:aws:acm:ap-southeast-1:ACCOUNT_ID:certificate/REPLACE_ME"
# dashboard_alb_subnet_ids      = ["subnet-REPLACE_ME_PUBLIC_A", "subnet-REPLACE_ME_PUBLIC_B"] # public, IGW route, >= 2 AZs
# dashboard_vpce_subnet_ids     = ["subnet-REPLACE_ME_PRIVATE_A", "subnet-REPLACE_ME_PRIVATE_B"]
# dashboard_auth_allowed_cidrs  = ["0.0.0.0/0"] # tighten to office/VPN ranges if internal-only

# Airflow MWAA (optional). After apply: .\scripts\cloud\deploy_platform.ps1 -Env prod -Action mwaa-sync
enable_mwaa                = false
mwaa_environment_class     = "mw1.medium"
mwaa_max_workers           = 5
mwaa_webserver_access_mode = "PRIVATE_ONLY"
